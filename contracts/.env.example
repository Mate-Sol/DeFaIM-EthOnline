# Arc Testnet deployment
# Copy to .env and fill in. NEVER commit .env — it is gitignored.

RPC_URL=https://rpc.testnet.arc.io
DEPLOYER_PRIVATE_KEY=0x...

# Optional overrides — all default sensibly if unset.
# MULTISIG=0x...          address granted MULTISIG_ROLE (default: deployer)
# DEPLOYER=0x...          address granted DEPLOYER_ROLE (default: deployer)
# DEMO_PSP=0x...          if set, factory.approvePsp() is called for it
# RESERVE_TARGET=1000000000   treasury reserve target, USDC base units (6 dec)
# STABLECOIN=0x...        overrides chain-based resolution; on Arc the native
#                         USDC precompile at 0x3600...0000 is used by default
