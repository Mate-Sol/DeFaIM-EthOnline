# ── Server ───────────────────────────────────────────────────────────────
PORT=5050
MONGODB_URI=mongodb://localhost:27017/defa
JWT_SECRET=change-me

# ── Arc ──────────────────────────────────────────────────────────────────
EVM_CHAIN_ID=5042002
EVM_RPC_URL=https://rpc.testnet.arc.io

# USDC on Arc — native gas token, 6-decimal ERC-20 interface
PAYFI_STABLECOIN_ADDRESS=0x3600000000000000000000000000000000000000
PAYFI_FACTORY_ADDRESS=0xB5AB6FD1672642cfafcf6A44b2eEAB712576f466
PAYFI_TREASURY_ADDRESS=0x227D4F1F50162b5bEe0567AdBbbb1296061CfE1f

# Server-side signer for agent operations. Use a dedicated key.
AGENT_PRIVATE_KEY=

# ── Privy — agent key custody ────────────────────────────────────────────
# When all four are set the server signs AGENT2_ROLE actions through Privy's
# enclave under a policy, and never holds the key. Unset, it falls back to
# AGENT_PRIVATE_KEY. Provision with: node scripts/privy-setup.js
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_WALLET_ID=
PRIVY_WALLET_ADDRESS=
# Only needed if the app requires signed requests (dashboard → authorization keys).
PRIVY_AUTHORIZATION_KEY=
