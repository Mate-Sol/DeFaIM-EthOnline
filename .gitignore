# Dependencies
node_modules/

# Builds
dist/
build/
out/
cache/
broadcast/

# Environment — NEVER commit a .env containing secrets
.env
.env.*
!.env.example
# Frontend build-time config: Vite bakes VITE_* into the static bundle, so
# these hold only public values (on-chain addresses, RPC, API URL) and must
# be present at image build time.
!web/lender/.env.production
!web/portal/.env.production
!web/external-psp/.env.production

# Foundry
contracts/out/
contracts/cache/

# Subgraph
subgraph/generated/
subgraph/build/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Vite build output
web/*/dist/

# Seed run state (contains live pool addresses per environment)
contracts/script/.seed-state
