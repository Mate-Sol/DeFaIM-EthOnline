# Lender client — production build. Vite bakes these into the static bundle
# at BUILD time, so every value here is public by definition: on-chain
# addresses, a public RPC, and the API base URL. No secrets.

VITE_API_URL=https://defa-arc-hackathon.invoicemate.net/api

# Arc Testnet
VITE_CHAIN_ID=5042002
VITE_CHAIN_NAME=Arc Testnet
VITE_CHAIN_NATIVE_SYMBOL=USDC
VITE_CHAIN_NATIVE_DECIMALS=18
VITE_RPC_URL=https://rpc.testnet.arc.io
VITE_CHAIN_EXPLORER_URL=https://testnet.arcscan.app

# Deployed contracts — see docs/DEPLOYMENTS.md
VITE_STABLECOIN_ADDRESS=0x3600000000000000000000000000000000000000
VITE_TREASURY_ADDRESS=0x227D4F1F50162b5bEe0567AdBbbb1296061CfE1f
VITE_FACTORY_ADDRESS=0xB5AB6FD1672642cfafcf6A44b2eEAB712576f466

# WalletConnect Cloud project id (public). Replace with a real id from
# cloud.reown.com — the placeholder makes the WalletConnect modal 403.
VITE_WALLETCONNECT_PROJECT_ID=defa2026defa2026defa2026defa2026
